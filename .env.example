# OpenAI API-Key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# Optional: Pfad zu einer cookies.txt (Netscape-Format), falls Instagram
# Downloads ohne Login blockiert werden. Export z.B. mit der Browser-
# Extension "Get cookies.txt LOCALLY".
YTDLP_COOKIES_FILE=

# Optional: maximale Videolaenge in Sekunden, die transkribiert wird
# (Schutz vor versehentlich hohen API-Kosten). Standard: 7200 (2h)
MAX_DURATION_SECONDS=7200
